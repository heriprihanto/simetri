# Salin ke .env dan isi kredensial server; jangan commit .env.
PORT=8987
SERVER_URL=https://monevrkpd.tegalkota.go.id/simetri
ROOT_PATH=/simetri
COOKIE_SECURE=true
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=
FORWARDED_ALLOW_IPS=127.0.0.1

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=simetri
DB_PASSWORD=
DB_NAME=simetri
DB_SSLMODE=prefer

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://monevrkpd.tegalkota.go.id/simetri/oauthcallback
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service_account.json
GDRIVE_PARENT_FOLDER_ID=
INITIAL_ADMIN_EMAIL=perencanaan.bappedategalkota@gmail.com

GEMINI_API_KEY=
# Sesuaikan dengan model yang tersedia pada akun Google AI server.
GEMINI_MODEL=gemini-3.5-flash
WA_API_URL=http://127.0.0.1:3000/send/message
WA_DEVICE_ID=Simetri
WA_STORAGE_PATH=/opt/go-whatsapp-web-multidevice/src
WA_MEDIA_DIR=
